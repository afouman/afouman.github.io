          )
          && companionsAreValid(eventId, request.resource.data)
          && request.resource.data.guestName == getAfter(/databases/$(database)/documents/events/$(eventId)/guests/$(guestUid)).data.guestName
          && request.resource.data.guestPhone == getAfter(/databases/$(database)/documents/events/$(eventId)/guests/$(guestUid)).data.guestPhone
          && (
