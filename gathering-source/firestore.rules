      match /name-index/{nameHash} {
        allow get: if true;
        allow list, delete: if canManageEvent(eventId);
      }

      match /guest-names/{nameHash} {
        allow get: if true;
        allow list: if canManageEvent(eventId);
        allow create: if (ownsGuestIdentity(request.resource.data.guestUid)
            || hostInvitesGuest(eventId, request.resource.data.guestUid))
          && request.resource.data.keys().hasOnly(['guestUid', 'guestName', 'createdAt'])
          && request.resource.data.guestUid is string
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() >= 2
          && request.resource.data.guestName.size() <= 80
          && request.resource.data.createdAt == request.time;
        allow delete: if canManageEvent(eventId) || ownsGuestIdentity(resource.data.guestUid);
      }

      match /guest-phones/{phoneHash} {
        allow get: if true;
        allow list: if canManageEvent(eventId);
        allow create: if (ownsGuestIdentity(request.resource.data.guestUid)
            || hostInvitesGuest(eventId, request.resource.data.guestUid))
          && request.resource.data.keys().hasOnly(['guestUid', 'guestPhone', 'createdAt'])
          && request.resource.data.guestUid is string
          && request.resource.data.guestPhone is string
          && request.resource.data.guestPhone.size() >= 11
          && request.resource.data.guestPhone.size() <= 16
          && request.resource.data.createdAt == request.time;
        allow delete: if canManageEvent(eventId) || ownsGuestIdentity(resource.data.guestUid);
      }

      match /guests/{guestUid} {
        allow get: if true;
        allow list: if canManageEvent(eventId);
        allow create: if (ownsGuestIdentity(guestUid) || hostInvitesGuest(eventId, guestUid))
          && request.resource.data.keys().hasOnly([
            'guestUid', 'accountUid', 'guestName', 'guestPhone', 'pinHash', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.guestUid == guestUid
          && (
            (ownsGuestIdentity(guestUid) && request.resource.data.accountUid == request.auth.uid)
            ||
            (hostInvitesGuest(eventId, guestUid)
              && exists(/databases/$(database)/documents/account-directory/$(request.resource.data.accountUid))
              && get(/databases/$(database)/documents/account-directory/$(request.resource.data.accountUid)).data.guestUid == guestUid
              && get(/databases/$(database)/documents/account-directory/$(request.resource.data.accountUid)).data.phone == request.resource.data.guestPhone)
