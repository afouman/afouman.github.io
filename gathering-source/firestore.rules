rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isApprovedHost() {
      return signedIn()
        && request.auth.token.email == 'alaki.dolaki.holholaki@gmail.com';
    }
    function isHost(eventId) {
      return signedIn()
        && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid;
    }
    function canManageEvent(eventId) {
      return isApprovedHost() || isHost(eventId);
    }
    function activeOrders(data) {
      return data.keys().hasAny(['activeOrderCount']) ? data.activeOrderCount : 0;
    }
    function guestProfile(eventId, guestUid) {
      return get(/databases/$(database)/documents/events/$(eventId)/guests/$(guestUid));
    }
    function guestRsvp(eventId, guestUid) {
      return get(/databases/$(database)/documents/events/$(eventId)/rsvps/$(guestUid));
    }
    function rsvpIsOpen(eventId) {
      return !get(/databases/$(database)/documents/events/$(eventId)).data.keys().hasAny(['rsvpOpen'])
        || get(/databases/$(database)/documents/events/$(eventId)).data.rsvpOpen == true;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isApprovedHost() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if canManageEvent(eventId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canManageEvent(eventId);

      match /orders/{orderId} {
        allow get, list: if true;
        allow create: if
          get(/databases/$(database)/documents/events/$(eventId)).data.accepting == true
          && request.resource.data.keys().hasOnly([
            'id', 'guestName', 'selections', 'note', 'status', 'createdAt',
            'updatedAt', 'guestUid', 'guestLabel', 'revision'
          ])
          && request.resource.data.id == orderId
          && request.resource.data.status == 'new'
          && request.resource.data.guestUid is string
          && exists(/databases/$(database)/documents/events/$(eventId)/guests/$(request.resource.data.guestUid))
          && exists(/databases/$(database)/documents/events/$(eventId)/rsvps/$(request.resource.data.guestUid))
          && guestRsvp(eventId, request.resource.data.guestUid).data.status == 'yes'
          && request.resource.data.guestName == guestProfile(eventId, request.resource.data.guestUid).data.guestName
          && getAfter(/databases/$(database)/documents/events/$(eventId)/rsvps/$(request.resource.data.guestUid)).data.activeOrderCount
            == activeOrders(guestRsvp(eventId, request.resource.data.guestUid).data) + 1
          && request.resource.data.revision == 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() > 0
          && request.resource.data.guestName.size() <= 80
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.selections is map;
        allow update: if canManageEvent(eventId) || (
          resource.data.status == 'new'
          && request.resource.data.guestUid == resource.data.guestUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status in ['new', 'cancelled']
          && (
            request.resource.data.status == 'cancelled'
            || (
              get(/databases/$(database)/documents/events/$(eventId)).data.accepting == true
              && guestRsvp(eventId, resource.data.guestUid).data.status == 'yes'
            )
          )
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedAt == request.time
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.selections is map
          && (
            request.resource.data.status == 'new'
            || (
              request.resource.data.cancelledAt == request.time
              && getAfter(/databases/$(database)/documents/events/$(eventId)/rsvps/$(resource.data.guestUid)).data.activeOrderCount
                == activeOrders(guestRsvp(eventId, resource.data.guestUid).data) - 1
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'guestName', 'guestLabel', 'selections', 'note', 'status',
            'updatedAt', 'cancelledAt', 'revision'
          ])
        );
        allow delete: if canManageEvent(eventId);
      }

      match /name-index/{nameHash} {
        allow get: if true;
        allow list, delete: if canManageEvent(eventId);
      }

      match /guest-names/{nameHash} {
        allow get: if true;
        allow list: if canManageEvent(eventId);
        allow create: if request.resource.data.keys().hasOnly(['guestUid', 'guestName', 'createdAt'])
          && request.resource.data.guestUid is string
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() >= 2
          && request.resource.data.guestName.size() <= 80
          && request.resource.data.createdAt == request.time;
        allow delete: if true;
      }

      match /guest-phones/{phoneHash} {
        allow get: if true;
        allow list: if canManageEvent(eventId);
        allow create: if request.resource.data.keys().hasOnly(['guestUid', 'guestPhone', 'createdAt'])
          && request.resource.data.guestUid is string
          && request.resource.data.guestPhone is string
          && request.resource.data.guestPhone.size() >= 11
          && request.resource.data.guestPhone.size() <= 16
          && request.resource.data.createdAt == request.time;
        allow delete: if true;
      }

      match /guests/{guestUid} {
        allow get: if true;
        allow list: if canManageEvent(eventId);
        allow create: if request.resource.data.keys().hasOnly([
            'guestUid', 'guestName', 'guestPhone', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.guestUid == guestUid
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() >= 2
          && request.resource.data.guestName.size() <= 80
          && request.resource.data.guestPhone is string
          && request.resource.data.guestPhone.size() >= 11
          && request.resource.data.guestPhone.size() <= 16
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if request.resource.data.guestUid == resource.data.guestUid
          && request.resource.data.guestPhone == resource.data.guestPhone
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() >= 2
          && request.resource.data.guestName.size() <= 80
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestName', 'updatedAt']);
        allow delete: if canManageEvent(eventId);
      }

      match /rsvps/{guestUid} {
        allow get: if true;
        allow list: if canManageEvent(eventId);
        allow create: if rsvpIsOpen(eventId)
          && request.resource.data.keys().hasOnly([
            'guestUid', 'guestName', 'guestPhone', 'status', 'activeOrderCount',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.guestUid == guestUid
          && request.resource.data.status in ['yes', 'maybe', 'no']
          && request.resource.data.activeOrderCount == 0
          && existsAfter(/databases/$(database)/documents/events/$(eventId)/guests/$(guestUid))
          && request.resource.data.guestName == getAfter(/databases/$(database)/documents/events/$(eventId)/guests/$(guestUid)).data.guestName
          && request.resource.data.guestPhone == getAfter(/databases/$(database)/documents/events/$(eventId)/guests/$(guestUid)).data.guestPhone
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if canManageEvent(eventId) || (
          request.resource.data.guestUid == resource.data.guestUid
          && request.resource.data.status in ['yes', 'maybe', 'no']
          && request.resource.data.activeOrderCount is int
          && request.resource.data.activeOrderCount >= 0
          && request.resource.data.guestName == getAfter(/databases/$(database)/documents/events/$(eventId)/guests/$(guestUid)).data.guestName
          && request.resource.data.guestPhone == getAfter(/databases/$(database)/documents/events/$(eventId)/guests/$(guestUid)).data.guestPhone
          && (
            request.resource.data.activeOrderCount == activeOrders(resource.data)
            || (
              request.resource.data.status == 'yes'
              && resource.data.status == 'yes'
              && (
                request.resource.data.activeOrderCount == activeOrders(resource.data) + 1
                || request.resource.data.activeOrderCount == activeOrders(resource.data) - 1
              )
            )
          )
          && (
            request.resource.data.status == resource.data.status
            || (
              rsvpIsOpen(eventId)
              && (resource.data.status != 'yes' || activeOrders(resource.data) == 0)
            )
          )
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'guestName', 'guestPhone', 'status', 'activeOrderCount', 'updatedAt'
          ])
        );
        allow delete: if canManageEvent(eventId);
      }
    }
  }
}
