rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isHost(eventId) {
      return signedIn() &&
        get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid;
    }
    function isRealAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isApprovedHost() {
      return isRealAccount()
        && request.auth.token.email == 'alaki.dolaki.holholaki@gmail.com';
    }
    function canManageEvent(eventId) {
      return isHost(eventId) || isApprovedHost();
    }
    function isGuest() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function isGoing(eventId) {
      return isGuest()
        && exists(/databases/$(database)/documents/events/$(eventId)/rsvps/$(request.auth.uid))
        && get(/databases/$(database)/documents/events/$(eventId)/rsvps/$(request.auth.uid)).data.status == 'yes';
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isApprovedHost() && request.resource.data.ownerUid == request.auth.uid;
      // The approved host can administer events created before the host
      // account was moved to its current email. The original owner ID stays
      // immutable, so a guest cannot claim an event.
      allow update: if canManageEvent(eventId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canManageEvent(eventId);

      match /orders/{orderId} {
        allow create: if isGoing(eventId)
          && get(/databases/$(database)/documents/events/$(eventId)).data.accepting == true
          && request.resource.data.keys().hasOnly([
            'id', 'guestName', 'selections', 'note', 'status', 'createdAt',
            'updatedAt', 'guestUid', 'guestLabel', 'revision'
          ])
          && request.resource.data.id == orderId
          && request.resource.data.status == 'new'
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.guestName == get(/databases/$(database)/documents/events/$(eventId)/rsvps/$(request.auth.uid)).data.guestName
          && request.resource.data.revision == 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() > 0
          && request.resource.data.guestName.size() <= 80
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.selections is map;
        allow get, list: if canManageEvent(eventId) || (isGuest() && resource.data.guestUid == request.auth.uid);
        allow update: if canManageEvent(eventId) || (
          isGuest()
          && resource.data.guestUid == request.auth.uid
          && resource.data.status == 'new'
          && request.resource.data.guestUid == resource.data.guestUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status in ['new', 'cancelled']
          && (
            request.resource.data.status == 'cancelled'
            || (get(/databases/$(database)/documents/events/$(eventId)).data.accepting == true && isGoing(eventId))
          )
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedAt == request.time
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() > 0
          && request.resource.data.guestName.size() <= 80
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.selections is map
          && (
            request.resource.data.status == 'new'
            || request.resource.data.cancelledAt == request.time
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'guestName', 'guestLabel', 'selections', 'note', 'status', 'updatedAt', 'cancelledAt', 'revision'
          ])
        );
        allow delete: if canManageEvent(eventId);
      }

      match /name-index/{nameHash} {
        allow get: if isGuest() || canManageEvent(eventId);
        allow list: if canManageEvent(eventId);
        allow delete: if canManageEvent(eventId);
      }

      match /guest-names/{nameHash} {
        allow get: if isGuest() || canManageEvent(eventId);
        allow list: if canManageEvent(eventId);
        allow create: if isGuest()
          && request.resource.data.keys().hasOnly(['guestUid', 'guestName', 'createdAt'])
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() >= 2
          && request.resource.data.guestName.size() <= 80
          && request.resource.data.createdAt == request.time;
        allow delete: if canManageEvent(eventId) || (isGuest() && resource.data.guestUid == request.auth.uid);
      }

      match /guest-phones/{phoneHash} {
        allow get: if isGuest() || canManageEvent(eventId);
        allow list: if canManageEvent(eventId);
        allow create: if isGuest()
          && request.resource.data.keys().hasOnly(['guestUid', 'guestPhone', 'createdAt'])
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.guestPhone is string
          && request.resource.data.guestPhone.size() >= 11
          && request.resource.data.guestPhone.size() <= 16
          && request.resource.data.createdAt == request.time;
        allow delete: if canManageEvent(eventId) || (isGuest() && resource.data.guestUid == request.auth.uid);
      }

      match /rsvps/{guestUid} {
        allow create: if isGuest()
          && guestUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'guestUid', 'guestName', 'guestPhone', 'status', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.status in ['yes', 'maybe', 'no']
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() >= 2
          && request.resource.data.guestName.size() <= 80
          && request.resource.data.guestPhone is string
          && request.resource.data.guestPhone.size() >= 11
          && request.resource.data.guestPhone.size() <= 16
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow get: if canManageEvent(eventId)
          || (isGuest() && guestUid == request.auth.uid);
        allow list: if canManageEvent(eventId);
        allow update: if canManageEvent(eventId) || (
          isGuest()
          && guestUid == request.auth.uid
          && request.resource.data.guestUid == resource.data.guestUid
          && request.resource.data.status in ['yes', 'maybe', 'no']
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() >= 2
          && request.resource.data.guestName.size() <= 80
          && request.resource.data.guestPhone is string
          && request.resource.data.guestPhone.size() >= 11
          && request.resource.data.guestPhone.size() <= 16
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'guestName', 'guestPhone', 'status', 'updatedAt'
          ])
        );
        allow delete: if canManageEvent(eventId);
      }
    }
  }
}
