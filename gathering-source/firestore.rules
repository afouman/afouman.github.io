rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email_verified == true;
    }
    function isLegacyHostAccount() {
      return verifiedEmail()
        && request.auth.token.email == 'alaki.dolaki.holholaki@gmail.com';
    }
    function isHost(eventId) {
      return verifiedEmail()
        && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid;
    }
    function canManageEvent(eventId) {
      return isHost(eventId) || (
        isLegacyHostAccount()
        && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid
          == 'W2T8SwFA1pdg8wxm23E5kQqbEHv2'
      );
    }
    function canClaimEventOwner(ownerUid) {
      return verifiedEmail() && (
        ownerUid == request.auth.uid
        || (isLegacyHostAccount() && ownerUid == 'W2T8SwFA1pdg8wxm23E5kQqbEHv2')
      );
    }
    function accountProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function hasCompleteAccount() {
      return verifiedEmail()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && accountProfile().data.uid == request.auth.uid
        && accountProfile().data.email == request.auth.token.email
        && accountProfile().data.firstName is string
        && accountProfile().data.lastName is string
        && accountProfile().data.phone is string
        && accountProfile().data.guestUid is string
        && (
          !accountProfile().data.keys().hasAny(['emailVerified'])
          || accountProfile().data.emailVerified == true
        )
        && exists(/databases/$(database)/documents/guest-identities/$(accountProfile().data.guestUid))
        && get(/databases/$(database)/documents/guest-identities/$(accountProfile().data.guestUid)).data.accountUid == request.auth.uid;
    }
    function ownsGuestIdentity(guestUid) {
      return hasCompleteAccount() && accountProfile().data.guestUid == guestUid;
    }
    function validHostInvitation(eventId, recipientUid, guestUid) {
      return signedIn()
        && canManageEvent(eventId)
        && existsAfter(/databases/$(database)/documents/users/$(recipientUid)/invitations/$(eventId))
        && getAfter(/databases/$(database)/documents/users/$(recipientUid)/invitations/$(eventId)).data.eventId == eventId
        && getAfter(/databases/$(database)/documents/users/$(recipientUid)/invitations/$(eventId)).data.hostUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(recipientUid)/invitations/$(eventId)).data.recipientUid == recipientUid
        && getAfter(/databases/$(database)/documents/users/$(recipientUid)/invitations/$(eventId)).data.recipientGuestUid == guestUid;
    }
    function hostInvitesGuest(eventId, guestUid) {
      return canManageEvent(eventId)
        && existsAfter(/databases/$(database)/documents/events/$(eventId)/guests/$(guestUid))
        && getAfter(/databases/$(database)/documents/events/$(eventId)/guests/$(guestUid)).data.accountUid is string
        && validHostInvitation(
          eventId,
          getAfter(/databases/$(database)/documents/events/$(eventId)/guests/$(guestUid)).data.accountUid,
          guestUid
        );
    }
    function hasHostInvitation(eventId) {
      return hasCompleteAccount()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/invitations/$(eventId))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/invitations/$(eventId)).data.recipientGuestUid
          == accountProfile().data.guestUid;
    }
    function activeOrders(data) {
      return data.keys().hasAny(['activeOrderCount']) ? data.activeOrderCount : 0;
    }
    function guestProfile(eventId, guestUid) {
      return get(/databases/$(database)/documents/events/$(eventId)/guests/$(guestUid));
    }
    function guestRsvp(eventId, guestUid) {
      return get(/databases/$(database)/documents/events/$(eventId)/rsvps/$(guestUid));
    }
    function rsvpIsOpen(eventId) {
      return !get(/databases/$(database)/documents/events/$(eventId)).data.keys().hasAny(['rsvpOpen'])
        || get(/databases/$(database)/documents/events/$(eventId)).data.rsvpOpen == true;
    }
    function eventRequiresApproval(eventId) {
      let event = get(/databases/$(database)/documents/events/$(eventId)).data;
      return event.keys().hasAny(['requireGuestApproval'])
        && event.requireGuestApproval == true;
    }
    function guestIsApprovedForEvent(eventId, guestUid) {
      return !eventRequiresApproval(eventId) || hasHostInvitation(eventId) || (
        exists(/databases/$(database)/documents/events/$(eventId)/rsvps/$(guestUid))
        && (
          guestRsvp(eventId, guestUid).data.status != 'yes'
          || !guestRsvp(eventId, guestUid).data.keys().hasAny(['approvalStatus'])
          || guestRsvp(eventId, guestUid).data.approvalStatus == 'approved'
        )
      );
    }
    function companionCount(data) {
      return data.keys().hasAny(['companions']) ? data.companions.size() : 0;
    }
    function maxAdditionalGuests(eventId) {
      let event = get(/databases/$(database)/documents/events/$(eventId)).data;
      return event.keys().hasAny(['maxAdditionalGuests']) ? event.maxAdditionalGuests : 0;
    }
    function companionsAreValid(eventId, data) {
      return (!data.keys().hasAny(['companions']) || data.companions is list)
        && companionCount(data) <= maxAdditionalGuests(eventId)
        && (data.status != 'no' || companionCount(data) == 0);
    }
    function chatIsOpen(eventId) {
      return !get(/databases/$(database)/documents/events/$(eventId)).data.keys().hasAny(['chatOpen'])
        || get(/databases/$(database)/documents/events/$(eventId)).data.chatOpen == true;
    }
    function guestCanChat(eventId, guestUid) {
      return exists(/databases/$(database)/documents/events/$(eventId)/rsvps/$(guestUid))
        && guestRsvp(eventId, guestUid).data.status == 'yes'
        && guestIsApprovedForEvent(eventId, guestUid);
    }
    function guestCanUseExpenses(eventId) {
      let guestUid = accountProfile().data.guestUid;
      return hasCompleteAccount()
        && exists(/databases/$(database)/documents/events/$(eventId)/expense-participants/$(guestUid))
        && get(/databases/$(database)/documents/events/$(eventId)/expense-participants/$(guestUid)).data.accountUid == request.auth.uid
        && exists(/databases/$(database)/documents/events/$(eventId)/rsvps/$(guestUid))
        && guestRsvp(eventId, guestUid).data.status == 'yes'
        && guestIsApprovedForEvent(eventId, guestUid);
    }
    function validChatActor(eventId, data) {
      return (
        data.authorRole == 'host'
        && canManageEvent(eventId)
        && data.authorUid == request.auth.uid
        && data.authorName == 'Host'
      ) || (
        data.authorRole == 'guest'
        && ownsGuestIdentity(data.authorUid)
        && guestCanChat(eventId, data.authorUid)
        && data.authorName == guestRsvp(eventId, data.authorUid).data.guestName
      );
    }
    function validLastChatActor(eventId, data) {
      return (
        data.lastActorRole == 'host'
        && canManageEvent(eventId)
        && data.lastActorUid == request.auth.uid
      ) || (
        data.lastActorRole == 'guest'
        && ownsGuestIdentity(data.lastActorUid)
        && guestCanChat(eventId, data.lastActorUid)
      );
    }
    function validReply(data) {
      return data.replyTo == null || (
        data.replyTo is map
        && data.replyTo.keys().hasOnly(['id', 'authorName', 'text'])
        && data.replyTo.id is string
        && data.replyTo.authorName is string
        && data.replyTo.text is string
        && data.replyTo.text.size() <= 300
      );
    }
    function removesOwnMessageFootprint(eventId, before, after) {
      let guestUid = accountProfile().data.guestUid;
      return ownsGuestIdentity(guestUid)
        && after.updatedAt == request.time
        && after.lastActorUid == guestUid
        && after.lastActorRole == 'guest'
        && after.reactions is map
        && after.pollVotes is map
        && after.pollVoterNames is map
        && after.reactions.diff(before.reactions).affectedKeys().hasOnly([guestUid])
        && after.pollVotes.diff(before.pollVotes).affectedKeys().hasOnly([guestUid])
        && after.pollVoterNames.diff(before.pollVoterNames).affectedKeys().hasOnly([guestUid])
        && !after.reactions.keys().hasAny([guestUid])
        && !after.pollVotes.keys().hasAny([guestUid])
        && !after.pollVoterNames.keys().hasAny([guestUid])
        && (
          after.replyTo == before.replyTo
          || (
            before.replyTo is map
            && after.replyTo == null
            && exists(/databases/$(database)/documents/events/$(eventId)/chat/$(before.replyTo.id))
            && get(/databases/$(database)/documents/events/$(eventId)/chat/$(before.replyTo.id)).data.authorUid == guestUid
          )
        )
        && after.diff(before).affectedKeys().hasOnly([
          'reactions', 'pollVotes', 'pollVoterNames', 'replyTo',
          'updatedAt', 'lastActorUid', 'lastActorRole'
        ]);
    }
    function messageDeleted(data) {
      return data.keys().hasAny(['deleted']) && data.deleted == true;
    }
    function pollBump(data) {
      return data.keys().hasAny(['pollBumpedAt']) ? data.pollBumpedAt : 0;
    }
    function pollChoiceModeUnchanged(before, after) {
      return (
        !before.keys().hasAny(['allowMultipleVotes'])
        && !after.keys().hasAny(['allowMultipleVotes'])
      ) || (
        before.keys().hasAny(['allowMultipleVotes'])
        && after.keys().hasAny(['allowMultipleVotes'])
        && after.allowMultipleVotes == before.allowMultipleVotes
      );
    }

    match /guest-identities/{guestUid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['accountUid', 'phone', 'createdAt'])
        && request.resource.data.accountUid == request.auth.uid
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 11
        && request.resource.data.phone.size() <= 16
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && resource.data.accountUid == request.auth.uid
        && request.resource.data.accountUid == resource.data.accountUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 11
        && request.resource.data.phone.size() <= 16
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone']);
      allow delete: if signedIn() && resource.data.accountUid == request.auth.uid;
    }

    match /account-phones/{phoneHash} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['accountUid', 'guestUid', 'phone', 'updatedAt'])
        && request.resource.data.accountUid == request.auth.uid
        && request.resource.data.guestUid is string
        && request.resource.data.guestUid.size() == 64
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 11
        && request.resource.data.phone.size() <= 16
        && request.resource.data.updatedAt == request.time
        && (resource == null || resource.data.accountUid == request.auth.uid);
      allow delete: if signedIn() && resource.data.accountUid == request.auth.uid;
    }

    match /account-emails/{emailHash} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly([
          'accountUid', 'email', 'guestUid', 'updatedAt'
        ])
        && request.resource.data.accountUid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email is string
        && request.resource.data.guestUid is string
        && request.resource.data.guestUid.size() == 64
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && resource.data.accountUid == request.auth.uid;
    }

    match /account-directory/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'firstName', 'lastName', 'displayName', 'phone', 'guestUid', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.guestUid is string
        && request.resource.data.guestUid.size() == 64
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'firstName', 'lastName', 'displayName', 'phone', 'guestUid',
          'membershipTier', 'membershipStatus', 'mutedEventIds',
          'emailVerified', 'verificationExpiresAt',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() >= 1
        && request.resource.data.firstName.size() <= 50
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() >= 1
        && request.resource.data.lastName.size() <= 60
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 11
        && request.resource.data.phone.size() <= 16
        && request.resource.data.guestUid is string
        && request.resource.data.guestUid.size() == 64
        && existsAfter(/databases/$(database)/documents/guest-identities/$(request.resource.data.guestUid))
        && getAfter(/databases/$(database)/documents/guest-identities/$(request.resource.data.guestUid)).data.accountUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/guest-identities/$(request.resource.data.guestUid)).data.phone == request.resource.data.phone
        && request.resource.data.membershipTier == 'free'
        && request.resource.data.membershipStatus == 'active'
        && request.resource.data.mutedEventIds is list
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && (
          (request.resource.data.emailVerified == true
            && request.resource.data.verificationExpiresAt == null)
          || (request.resource.data.emailVerified == false
            && request.resource.data.verificationExpiresAt is timestamp
            && request.resource.data.verificationExpiresAt > request.time + duration.value(89, 'd')
            && request.resource.data.verificationExpiresAt < request.time + duration.value(91, 'd'))
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == userId
        && (
          !resource.data.keys().hasAny(['emailVerified', 'verificationExpiresAt'])
          || resource.data.emailVerified == true
          || resource.data.verificationExpiresAt > request.time
        )
        && request.resource.data.uid == resource.data.uid
        && (
          request.resource.data.email == resource.data.email
          || (request.auth.token.email_verified == true
            && request.resource.data.email == request.auth.token.email)
        )
        && request.resource.data.guestUid == resource.data.guestUid
        && request.resource.data.membershipTier == resource.data.membershipTier
        && request.resource.data.membershipStatus == resource.data.membershipStatus
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() >= 1
        && request.resource.data.firstName.size() <= 50
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() >= 1
        && request.resource.data.lastName.size() <= 60
        && (
          (!resource.data.keys().hasAny(['displayName'])
            && !request.resource.data.keys().hasAny(['displayName']))
          || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 2
            && request.resource.data.displayName.size() <= 80)
        )
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 11
        && request.resource.data.phone.size() <= 16
        && getAfter(/databases/$(database)/documents/guest-identities/$(request.resource.data.guestUid)).data.phone == request.resource.data.phone
        && request.resource.data.mutedEventIds is list
        && (
          !resource.data.keys().hasAny(['emailVerified', 'verificationExpiresAt'])
          || request.resource.data.keys().hasAll(['emailVerified', 'verificationExpiresAt'])
        )
        && (
          !request.resource.data.keys().hasAny(['emailVerified', 'verificationExpiresAt'])
          || (
            request.resource.data.emailVerified == request.auth.token.email_verified
            && (
              (request.resource.data.emailVerified == true
                && request.resource.data.verificationExpiresAt == null)
              || (request.resource.data.emailVerified == false
                && request.resource.data.verificationExpiresAt == resource.data.verificationExpiresAt)
            )
          )
        )
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'firstName', 'lastName', 'displayName', 'phone', 'mutedEventIds',
          'emailVerified', 'verificationExpiresAt', 'updatedAt'
        ]);
      allow delete: if signedIn() && request.auth.uid == userId;

      match /invitations/{eventId} {
        allow get: if signedIn() && (request.auth.uid == userId || canManageEvent(eventId));
        allow list: if signedIn()
          && (request.auth.uid == userId || resource.data.hostUid == request.auth.uid);
        allow create, update: if canManageEvent(eventId)
          && request.resource.data.keys().hasOnly([
            'eventId', 'eventTitle', 'hostUid', 'recipientUid', 'recipientGuestUid',
            'recipientEmail', 'recipientPhone', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.eventId == eventId
          && request.resource.data.eventTitle is string
          && request.resource.data.eventTitle.size() > 0
          && request.resource.data.eventTitle.size() <= 120
          && request.resource.data.hostUid == request.auth.uid
          && request.resource.data.recipientUid == userId
          && request.resource.data.recipientGuestUid is string
          && request.resource.data.recipientGuestUid.size() == 64
          && request.resource.data.recipientEmail is string
          && request.resource.data.recipientPhone is string
          && request.resource.data.updatedAt == request.time
          && (
            (resource == null && request.resource.data.createdAt == request.time)
            || (resource != null && request.resource.data.createdAt == resource.data.createdAt)
          );
        allow delete: if signedIn() && (
          request.auth.uid == userId
          || resource.data.hostUid == request.auth.uid
          || canManageEvent(eventId)
        );
      }

      match /phone-invitations/{inviteId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'eventId', 'eventTitle', 'hostUid', 'recipientUid', 'recipientGuestUid',
            'recipientPhone', 'recipientName', 'inviteUrl', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.eventId is string
          && request.resource.data.eventTitle is string
          && request.resource.data.eventTitle.size() > 0
          && request.resource.data.eventTitle.size() <= 120
          && request.resource.data.hostUid == request.auth.uid
          && request.resource.data.recipientUid is string
          && request.resource.data.recipientGuestUid is string
          && request.resource.data.recipientGuestUid.size() == 64
          && request.resource.data.recipientPhone is string
          && request.resource.data.recipientPhone.size() >= 11
          && request.resource.data.recipientPhone.size() <= 16
          && request.resource.data.recipientName is string
          && request.resource.data.recipientName.size() <= 80
          && request.resource.data.inviteUrl is string
          && request.resource.data.inviteUrl.size() <= 500
          && request.resource.data.updatedAt == request.time
          && (
            (resource == null && request.resource.data.createdAt == request.time)
            || (resource != null && request.resource.data.createdAt == resource.data.createdAt)
          );
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /contacts/{contactUid} {
        allow get: if signedIn()
          && (request.auth.uid == userId || resource.data.accountUid == request.auth.uid);
        allow list: if signedIn()
          && (request.auth.uid == userId || resource.data.accountUid == request.auth.uid);
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'accountUid', 'guestUid', 'email', 'phone', 'firstName', 'lastName',
            'inviteCount', 'eventIds', 'lastInvitedAt'
          ])
          && request.resource.data.accountUid == contactUid
          && request.resource.data.guestUid is string
          && request.resource.data.email is string
          && request.resource.data.phone is string
          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && request.resource.data.inviteCount is int
          && request.resource.data.inviteCount >= 1
          && request.resource.data.eventIds is list
          && request.resource.data.lastInvitedAt == request.time;
        allow delete: if signedIn()
          && (request.auth.uid == userId || resource.data.accountUid == request.auth.uid);
      }
    }

    // Account deletion must find records the user created beneath other user
    // documents. Collection-group queries require a recursive match; the
    // query is still restricted to records that name the signed-in account.
    match /{parentPath=**}/invitations/{eventId} {
      allow read: if signedIn() && resource.data.hostUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    match /{parentPath=**}/contacts/{contactUid} {
      allow read: if signedIn() && resource.data.accountUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.accountUid == request.auth.uid;
    }

    match /public-paths/{pathHash} {
      allow get: if true;
      allow list: if false;
      allow create: if hasCompleteAccount()
        && request.resource.data.keys().hasOnly([
          'eventId', 'ownerUid', 'publicPath', 'createdAt'
        ])
        && canClaimEventOwner(request.resource.data.ownerUid)
        && request.resource.data.eventId is string
        && request.resource.data.publicPath is string
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && getAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.ownerUid == request.resource.data.ownerUid
        && getAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.publicPath == request.resource.data.publicPath
        && getAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.publicPathClaimId == pathHash;
      allow update: if false;
      allow delete: if canManageEvent(resource.data.eventId);
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if hasCompleteAccount()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.publicPath is string
        && request.resource.data.publicPathClaimId is string
        && existsAfter(/databases/$(database)/documents/public-paths/$(request.resource.data.publicPathClaimId))
        && getAfter(/databases/$(database)/documents/public-paths/$(request.resource.data.publicPathClaimId)).data.eventId == eventId
        && getAfter(/databases/$(database)/documents/public-paths/$(request.resource.data.publicPathClaimId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/public-paths/$(request.resource.data.publicPathClaimId)).data.publicPath == request.resource.data.publicPath;
      allow update: if canManageEvent(eventId)
        && (
          (resource.data.keys().hasAny(['ownerUid'])
            && request.resource.data.ownerUid == resource.data.ownerUid)
          ||
          (!resource.data.keys().hasAny(['ownerUid'])
            && isLegacyHostAccount()
            && request.resource.data.ownerUid == request.auth.uid)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'publicPath', 'publicPathClaimId'
          ])
          || (
            request.resource.data.publicPath is string
            && request.resource.data.publicPathClaimId is string
            && existsAfter(/databases/$(database)/documents/public-paths/$(request.resource.data.publicPathClaimId))
            && getAfter(/databases/$(database)/documents/public-paths/$(request.resource.data.publicPathClaimId)).data.eventId == eventId
            && getAfter(/databases/$(database)/documents/public-paths/$(request.resource.data.publicPathClaimId)).data.ownerUid == request.resource.data.ownerUid
            && getAfter(/databases/$(database)/documents/public-paths/$(request.resource.data.publicPathClaimId)).data.publicPath == request.resource.data.publicPath
          )
        );
      allow delete: if canManageEvent(eventId);

      match /orders/{orderId} {
        allow get, list: if true;
        allow create: if
          ownsGuestIdentity(request.resource.data.guestUid)
          &&
          get(/databases/$(database)/documents/events/$(eventId)).data.accepting == true
          && request.resource.data.keys().hasOnly([
            'id', 'guestName', 'selections', 'note', 'status', 'createdAt',
            'updatedAt', 'guestUid', 'guestLabel', 'revision'
          ])
          && request.resource.data.id == orderId
          && request.resource.data.status == 'new'
          && request.resource.data.guestUid is string
          && exists(/databases/$(database)/documents/events/$(eventId)/guests/$(request.resource.data.guestUid))
          && exists(/databases/$(database)/documents/events/$(eventId)/rsvps/$(request.resource.data.guestUid))
          && guestRsvp(eventId, request.resource.data.guestUid).data.status == 'yes'
          && guestIsApprovedForEvent(eventId, request.resource.data.guestUid)
          && request.resource.data.guestName == guestProfile(eventId, request.resource.data.guestUid).data.guestName
          && getAfter(/databases/$(database)/documents/events/$(eventId)/rsvps/$(request.resource.data.guestUid)).data.activeOrderCount
            == activeOrders(guestRsvp(eventId, request.resource.data.guestUid).data) + 1
          && request.resource.data.revision == 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() > 0
          && request.resource.data.guestName.size() <= 80
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.selections is map;
        allow update: if canManageEvent(eventId) || (
          ownsGuestIdentity(resource.data.guestUid)
          &&
          resource.data.status == 'new'
          && request.resource.data.guestUid == resource.data.guestUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status in ['new', 'cancelled']
          && (
            request.resource.data.status == 'cancelled'
            || (
              get(/databases/$(database)/documents/events/$(eventId)).data.accepting == true
              && guestRsvp(eventId, resource.data.guestUid).data.status == 'yes'
              && guestIsApprovedForEvent(eventId, resource.data.guestUid)
            )
          )
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedAt == request.time
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.selections is map
          && (
            request.resource.data.status == 'new'
            || (
              request.resource.data.cancelledAt == request.time
              && getAfter(/databases/$(database)/documents/events/$(eventId)/rsvps/$(resource.data.guestUid)).data.activeOrderCount
                == activeOrders(guestRsvp(eventId, resource.data.guestUid).data) - 1
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'guestName', 'guestLabel', 'selections', 'note', 'status',
            'updatedAt', 'cancelledAt', 'revision'
          ])
        );
        allow delete: if canManageEvent(eventId) || ownsGuestIdentity(resource.data.guestUid);
      }

      match /expense-participants/{participantId} {
        allow read: if canManageEvent(eventId) || guestCanUseExpenses(eventId) || (
          signedIn() && resource.data.accountUid == request.auth.uid
        );
        allow create: if canManageEvent(eventId) || (
          hasCompleteAccount()
          && request.resource.data.accountUid == request.auth.uid
          && request.resource.data.primaryGuestUid == accountProfile().data.guestUid
          && existsAfter(/databases/$(database)/documents/events/$(eventId)/rsvps/$(accountProfile().data.guestUid))
          && request.resource.data.status == getAfter(/databases/$(database)/documents/events/$(eventId)/rsvps/$(accountProfile().data.guestUid)).data.status
          && request.resource.data.approvalStatus == getAfter(/databases/$(database)/documents/events/$(eventId)/rsvps/$(accountProfile().data.guestUid)).data.approvalStatus
        )
        && request.resource.data.keys().hasOnly([
          'id', 'accountUid', 'primaryGuestUid', 'name', 'role', 'status',
          'approvalStatus', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == participantId
        && request.resource.data.accountUid is string
        && request.resource.data.primaryGuestUid is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.role in ['host', 'guest', 'companion']
        && request.resource.data.status in ['host', 'invited', 'yes', 'maybe', 'no']
        && request.resource.data.approvalStatus in ['pending', 'approved', 'declined']
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
        allow update: if (canManageEvent(eventId) || (
          hasCompleteAccount()
          && (resource.data.accountUid == request.auth.uid || resource.data.accountUid == '')
          && request.resource.data.accountUid == request.auth.uid
          && resource.data.primaryGuestUid == accountProfile().data.guestUid
          && request.resource.data.primaryGuestUid == resource.data.primaryGuestUid
          && request.resource.data.role == resource.data.role
          && (
            (
              existsAfter(/databases/$(database)/documents/events/$(eventId)/rsvps/$(accountProfile().data.guestUid))
              && request.resource.data.status == getAfter(/databases/$(database)/documents/events/$(eventId)/rsvps/$(accountProfile().data.guestUid)).data.status
              && request.resource.data.approvalStatus == getAfter(/databases/$(database)/documents/events/$(eventId)/rsvps/$(accountProfile().data.guestUid)).data.approvalStatus
            ) || (
              !existsAfter(/databases/$(database)/documents/events/$(eventId)/rsvps/$(accountProfile().data.guestUid))
              && hasHostInvitation(eventId)
              && request.resource.data.status == resource.data.status
              && request.resource.data.approvalStatus == resource.data.approvalStatus
            )
          )
        ))
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'accountUid', 'name', 'status', 'approvalStatus', 'updatedAt'
        ]);
        allow delete: if canManageEvent(eventId) || (
          hasCompleteAccount()
          && resource.data.primaryGuestUid == accountProfile().data.guestUid
          && (resource.data.accountUid == request.auth.uid || resource.data.accountUid == '')
