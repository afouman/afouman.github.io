            'runtime', 'createdBy', 'createdAt', 'updatedAt', 'version'
          ])
          && request.resource.data.id == gameId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status in ['draft', 'published']
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 90
          && request.resource.data.summary is string
          && request.resource.data.summary.size() <= 2000
          && request.resource.data.playerArrangement is string
          && request.resource.data.playerArrangement.size() >= 1
          && request.resource.data.playerArrangement.size() <= 6000
          && request.resource.data.interfaceDescription is string
          && request.resource.data.interfaceDescription.size() >= 1
          && request.resource.data.interfaceDescription.size() <= 6000
          && request.resource.data.rules is string
          && request.resource.data.rules.size() >= 1
          && request.resource.data.rules.size() <= 6000
          && request.resource.data.scoring is string
          && request.resource.data.scoring.size() <= 6000
          && request.resource.data.timing is string
          && request.resource.data.timing.size() <= 6000
          && request.resource.data.hiddenInformation is string
          && request.resource.data.hiddenInformation.size() <= 6000
          && request.resource.data.winCondition is string
          && request.resource.data.winCondition.size() <= 6000
          && request.resource.data.minPlayers is int
          && request.resource.data.minPlayers >= 1
          && request.resource.data.maxPlayers is int
          && request.resource.data.maxPlayers >= request.resource.data.minPlayers
          && request.resource.data.maxPlayers <= 100
          && (
            request.resource.data.runtime == null
            || (
              request.resource.data.runtime is map
              && request.resource.data.runtime.keys().hasOnly(['instructions', 'logicSource', 'uiNotes'])
              && request.resource.data.runtime.instructions is string
              && request.resource.data.runtime.instructions.size() <= 1000
              && request.resource.data.runtime.logicSource is string
              && request.resource.data.runtime.logicSource.size() <= 16000
              && request.resource.data.runtime.uiNotes is string
              && request.resource.data.runtime.uiNotes.size() <= 1000
            )
          )
          && (request.resource.data.status == 'draft' || request.resource.data.runtime != null)
          && request.resource.data.version is int
          && request.resource.data.version >= 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if canManageEvent(eventId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.version is int
          && request.resource.data.version > resource.data.version
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'summary', 'status', 'playerArrangement',
            'interfaceDescription', 'rules', 'scoring', 'timing',
            'hiddenInformation', 'winCondition', 'minPlayers', 'maxPlayers',
            'runtime', 'updatedAt', 'version'
          ])
          && request.resource.data.status in ['draft', 'published']
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 90
          && request.resource.data.playerArrangement is string
          && request.resource.data.playerArrangement.size() >= 1
          && request.resource.data.interfaceDescription is string
          && request.resource.data.interfaceDescription.size() >= 1
          && request.resource.data.rules is string
          && request.resource.data.rules.size() >= 1
          && request.resource.data.minPlayers is int
          && request.resource.data.minPlayers >= 1
          && request.resource.data.maxPlayers is int
          && request.resource.data.maxPlayers >= request.resource.data.minPlayers
          && request.resource.data.maxPlayers <= 100
          && (request.resource.data.status == 'draft' || request.resource.data.runtime != null);
        allow delete: if canManageEvent(eventId);
      }

      match /chat/{messageId} {
        allow read: if true;
        allow create: if chatIsOpen(eventId)
          && request.resource.data.keys().hasOnly([
            'id', 'type', 'authorUid', 'authorName', 'authorRole', 'text',
            'createdAt', 'updatedAt', 'edited', 'replyTo', 'reactions',
            'pollQuestion', 'pollOptions', 'pollVotes', 'pollVoterNames',
            'allowGuestOptions', 'allowMultipleVotes', 'pollBumpedAt',
            'pinned', 'pinnedAt', 'pinnedByName', 'deleted',
            'lastActorUid', 'lastActorRole'
          ])
          && request.resource.data.id == messageId
          && request.resource.data.type in ['message', 'poll']
          && validChatActor(eventId, request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.edited == false
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && validReply(request.resource.data)
          && request.resource.data.reactions is map
          && request.resource.data.pollVotes is map
          && request.resource.data.pollVoterNames is map
          && request.resource.data.pollOptions is list
          && request.resource.data.pollOptions.size() <= 20
          && request.resource.data.pollQuestion is string
          && request.resource.data.pollQuestion.size() <= 300
          && request.resource.data.allowGuestOptions is bool
          && request.resource.data.allowMultipleVotes is bool
          && request.resource.data.pollBumpedAt == 0
          && request.resource.data.pinned == false
          && request.resource.data.pinnedAt == 0
          && request.resource.data.pinnedByName == ''
          && request.resource.data.deleted == false
          && request.resource.data.lastActorUid == request.resource.data.authorUid
          && request.resource.data.lastActorRole == request.resource.data.authorRole
          && (
            (request.resource.data.type == 'message'
              && request.resource.data.text.size() > 0
              && request.resource.data.pollQuestion == ''
              && request.resource.data.pollOptions.size() == 0)
            ||
            (request.resource.data.type == 'poll'
              && request.resource.data.authorRole == 'host'
              && request.resource.data.text == ''
              && request.resource.data.pollQuestion.size() > 0
              && request.resource.data.pollOptions.size() >= 2)
          );
        allow update: if chatIsOpen(eventId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.type == resource.data.type
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.authorRole == resource.data.authorRole
          && request.resource.data.updatedAt == request.time
          && validLastChatActor(eventId, request.resource.data)
          && (
            (
              request.resource.data.type == 'message'
              && !messageDeleted(resource.data)
              && !messageDeleted(request.resource.data)
              && request.resource.data.lastActorUid == resource.data.authorUid
              && request.resource.data.lastActorRole == resource.data.authorRole
              && validChatActor(eventId, request.resource.data)
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000
              && request.resource.data.edited == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'text', 'edited', 'updatedAt', 'lastActorUid', 'lastActorRole'
              ])
            ) || (
              !messageDeleted(resource.data)
              && !messageDeleted(request.resource.data)
              && request.resource.data.reactions is map
              && request.resource.data.pollVotes is map
              && (
                !request.resource.data.keys().hasAny(['pollVoterNames'])
                || request.resource.data.pollVoterNames is map
              )
              && request.resource.data.pollOptions is list
              && request.resource.data.pollOptions.size() <= 20
              && pollChoiceModeUnchanged(resource.data, request.resource.data)
              && (
                (
                  request.resource.data.pollOptions == resource.data.pollOptions
                  && pollBump(request.resource.data) == pollBump(resource.data)
                )
                || (
                  request.resource.data.type == 'poll'
                  && (resource.data.allowGuestOptions == true || request.resource.data.lastActorRole == 'host')
                  && request.resource.data.pollBumpedAt is int
                  && request.resource.data.pollBumpedAt > pollBump(resource.data)
                )
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'reactions', 'pollVotes', 'pollVoterNames', 'pollOptions',
                'pollBumpedAt', 'updatedAt', 'lastActorUid', 'lastActorRole'
              ])
            ) || (
              !messageDeleted(resource.data)
              && !messageDeleted(request.resource.data)
              && request.resource.data.lastActorRole == 'host'
              && canManageEvent(eventId)
              && request.resource.data.pinned is bool
              && request.resource.data.pinnedAt is int
              && request.resource.data.pinnedByName is string
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'pinned', 'pinnedAt', 'pinnedByName', 'updatedAt',
                'lastActorUid', 'lastActorRole'
              ])
            ) || (
              !messageDeleted(resource.data)
              && request.resource.data.deleted == true
              && request.resource.data.text == ''
              && request.resource.data.pollQuestion == ''
              && request.resource.data.pollOptions.size() == 0
              && request.resource.data.pollVotes.size() == 0
              && request.resource.data.pollVoterNames.size() == 0
              && request.resource.data.pollBumpedAt == 0
              && request.resource.data.reactions.size() == 0
              && request.resource.data.replyTo == null
              && request.resource.data.pinned == false
              && request.resource.data.pinnedAt == 0
              && request.resource.data.pinnedByName == ''
              && (
                (request.resource.data.lastActorRole == 'host' && canManageEvent(eventId))
                || (
                  request.resource.data.lastActorUid == resource.data.authorUid
                  && request.resource.data.lastActorRole == resource.data.authorRole
                  && validChatActor(eventId, request.resource.data)
                )
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'text', 'pollQuestion', 'pollOptions', 'pollVotes',
                'pollVoterNames', 'pollBumpedAt', 'reactions',
                'replyTo', 'edited', 'pinned', 'pinnedAt', 'pinnedByName',
                'deleted', 'updatedAt', 'lastActorUid', 'lastActorRole'
              ])
            )
          );
        allow update: if removesOwnMessageFootprint(eventId, resource.data, request.resource.data);
        allow delete: if canManageEvent(eventId) || (
          resource.data.authorRole == 'guest'
          && ownsGuestIdentity(resource.data.authorUid)
        );
      }
    }
  }
}
