          && request.resource.data.keys is map
          && request.resource.data.keys.keys().hasOnly(['p256dh', 'auth'])
          && request.resource.data.keys.p256dh is string
          && request.resource.data.keys.auth is string
          && request.resource.data.actorUid is string
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() > 0
          && request.resource.data.actorName.size() <= 80
          && request.resource.data.actorRole in ['host', 'guest']
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && (
            (request.resource.data.actorRole == 'host'
              && canManageEvent(eventId)
              && request.resource.data.actorUid == request.auth.uid
              && request.resource.data.actorName == 'Host')
            ||
            (request.resource.data.actorRole == 'guest'
              && ownsGuestIdentity(request.resource.data.actorUid)
              && guestCanChat(eventId, request.resource.data.actorUid)
              && request.resource.data.actorName
                == guestRsvp(eventId, request.resource.data.actorUid).data.guestName)
