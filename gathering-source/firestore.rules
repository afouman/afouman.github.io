        allow create: if (canManageEvent(eventId) || (
          guestCanUseExpenses(eventId)
          && request.resource.data.submittedByAccountUid == request.auth.uid
          && request.resource.data.submittedByUid == accountProfile().data.guestUid
          && request.resource.data.submittedByRole == 'guest'
