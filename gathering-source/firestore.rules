          && request.resource.data.guestName.size() >= 2
          && request.resource.data.guestName.size() <= 80
          && request.resource.data.guestPhone is string
          && request.resource.data.guestPhone.size() >= 11
          && request.resource.data.guestPhone.size() <= 16
          && (!request.resource.data.keys().hasAny(['pinHash']) || (
            request.resource.data.pinHash is string
            && request.resource.data.pinHash.size() == 64
          ))
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if ownsGuestIdentity(guestUid)
          && request.resource.data.guestUid == resource.data.guestUid
          && request.resource.data.accountUid == request.auth.uid
          && request.resource.data.guestPhone == accountProfile().data.phone
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() >= 2
          && request.resource.data.guestName.size() <= 80
          && (
