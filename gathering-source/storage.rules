rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function canManageEvent(eventId) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (
          firestore.get(/databases/(default)/documents/events/$(eventId)).data.ownerUid == request.auth.uid
          || (
            request.auth.token.email == 'alaki.dolaki.holholaki@gmail.com'
            && firestore.get(/databases/(default)/documents/events/$(eventId)).data.ownerUid
              == 'W2T8SwFA1pdg8wxm23E5kQqbEHv2'
          )
        );
    }
    function guestCanAttachToChat(eventId, guestUid) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.guestUid == guestUid
        && firestore.exists(/databases/(default)/documents/events/$(eventId)/rsvps/$(guestUid))
        && firestore.get(/databases/(default)/documents/events/$(eventId)/rsvps/$(guestUid)).data.status == 'yes'
        && (!firestore.get(/databases/(default)/documents/events/$(eventId)).data.keys().hasAny(['chatOpen'])
          || firestore.get(/databases/(default)/documents/events/$(eventId)).data.chatOpen == true);
    }
    match /events/{eventId}/items/{fileName} {
      allow read: if true;
      allow create, update: if canManageEvent(eventId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if canManageEvent(eventId);
    }
    match /events/{eventId}/chat/{guestUid}/{fileName} {
      allow read: if true;
      allow create: if (canManageEvent(eventId) || guestCanAttachToChat(eventId, guestUid))
        && request.resource.size < 25 * 1024 * 1024;
      allow delete: if canManageEvent(eventId) || guestCanAttachToChat(eventId, guestUid);
    }
  }
}
