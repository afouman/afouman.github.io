{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gathering-domain",
	"main": "worker.js",
	"compatibility_date": "2026-10-04",
	"workers_dev": true,
	"vars": {
		"GEMINI_MODEL": "gemini-3.5-flash-lite",
		"GEMINI_FALLBACK_MODELS": "gemini-3.8-flash,gemini-2.5-flash-lite",
		"GAME_GENERATION_DAILY_LIMIT": "15"
	},
	"triggers": {
		"crons": ["17 3 * * *"]
	},
	"routes": [
		{
			"pattern": "gaemaj.tech/*",
			"zone_name": "gaemaj.tech"
		}
	],
	"kv_namespaces": [
		{
			"binding": "PUSH_SUBSCRIPTIONS",
			"id": "82b5a8b6e67340598056c1c0cae12219"
		}
	]
}
